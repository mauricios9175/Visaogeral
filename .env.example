# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes na Vercel.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Meta: token do Usuário do Sistema do seu BM (não expira)
META_SYSTEM_USER_TOKEN=
# Meta: app criado em developers.facebook.com (para o Login com Facebook)
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v23.0

# Acesso ao painel
APP_PASSWORD=
# Texto aleatório longo. Gere com: openssl rand -hex 32
SESSION_SECRET=

# Mesmo valor nos secrets do GitHub Actions. Gere com: openssl rand -hex 32
CRON_SECRET=
