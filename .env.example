# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes na Vercel.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Meta: token do Usuário do Sistema do seu BM (não expira)
META_SYSTEM_USER_TOKEN=
# Meta: app criado em developers.facebook.com (para o Login com Facebook)
META_APP_ID=
META_APP_SECRET=
# ID da configuração do "Login do Facebook para Empresas" (apps do tipo Empresa)
META_LOGIN_CONFIG_ID=
META_API_VERSION=v25.0

# Acesso ao painel
APP_PASSWORD=
# Texto aleatório longo. Gere com: openssl rand -hex 32
SESSION_SECRET=

# Mesmo valor nos secrets do GitHub Actions. Gere com: openssl rand -hex 32
CRON_SECRET=

# Google Ads: cliente OAuth (Google Cloud → Google Auth Platform → Clientes, tipo "Aplicativo da Web").
# URI de redirecionamento: https://SEU-PAINEL/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chave de API do Google Cloud (Credenciais → Criar credenciais → Chave de API), restrita à Google Picker API.
# Usada para escolher no Drive a pasta de relatórios de cada cliente.
GOOGLE_API_KEY=
# Opcionais: versão da API e token de desenvolvedor antigo (desde set/2026 não é mais exigido)
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_DEVELOPER_TOKEN=
